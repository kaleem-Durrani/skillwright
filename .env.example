# Skillwright environment.
#
# Copy to `.env` and edit. Every key below is validated by apps/api/src/env.ts at
# boot; a missing or malformed value stops the process with a list of ALL problems,
# not the first one. The defaults here match docker-compose.yml exactly, so a fresh
# clone works after `pnpm infra:up` with no edits.

# --- runtime -----------------------------------------------------------------

# Node's own mode. Controls log formatting and dependency behaviour, nothing else.
NODE_ENV=development
# Where this process actually runs. Kept separate from NODE_ENV because staging runs
# NODE_ENV=production but must still be allowed to expose the demo login.
# One of: local | ci | staging | production
DEPLOY_ENV=local

PORT=4000
# 0.0.0.0 so the port is reachable from a container host. Use 127.0.0.1 to bind local only.
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Number of reverse-proxy hops to trust when deriving the client IP. 0 means ignore
# X-Forwarded-For entirely — set this ONLY to the real hop count, since every trusted
# hop is a header a client could otherwise spoof to dodge rate limiting.
#
# WHAT SETTING IT DOES: it makes `request.ip` the address your outermost trusted hop
# recorded, so the per-ADDRESS rate-limit buckets count people rather than
# infrastructure.
#
# WHAT IT DOES NOT DO:
#   - it authenticates nothing. Every hop counted here is a header a client could forge
#     if it could reach this process without passing through them, so the number must
#     equal the REAL hop count. One hop too many and a caller picks its own bucket by
#     sending its own X-Forwarded-For.
#   - it does not make the signed-in bucket trustworthy, or vice versa. RATE_LIMIT_API_USER_MAX
#     keys on the session's user id and needs no proxy configuration at all, which is
#     why that bucket is the one that still works when this is wrong.
#   - it does not affect RATE_LIMIT_AUTH_*: a wrong key there costs an attacker a few
#     extra guesses against a bucket keyed on the account itself.
#
# The API logs a warning on every boot when this is 0 outside local development, and
# logs the whole bucket table either way — see "api process starting" and "rate limit
# buckets configured".
TRUST_PROXY_HOPS=0

# --- datastores --------------------------------------------------------------

# Postgres from docker-compose: user/password/database are all "skillwright".
DATABASE_URL=postgresql://skillwright:skillwright@localhost:5433/skillwright?schema=public

# Redis backs rate-limit counters, the BullMQ queues and the socket.io adapter.
REDIS_URL=redis://localhost:6379

# --- sessions & crypto -------------------------------------------------------

# The __Host- prefix pins the cookie to this exact origin with Path=/ and forbids a
# Domain attribute — a subdomain takeover cannot then write a session cookie for us.
#
# It needs a SECURE CONTEXT, which is not the same as https: localhost and 127.0.0.1
# are trustworthy origins, so this works unchanged over plain http on your machine.
# Measured in Chromium — http://localhost and http://127.0.0.1 both store and return
# __Host-sw_session; http://<LAN-IP> silently drops it. This file used to say "if you
# run local dev over plain http, rename this to sw_session", which contradicted the
# README's promise that the copied .env needs no edits. The README was right.
#
# The case that DOES need the rename is the one this project invites: opening the dev
# server from a real phone on the same network (ADR 0008 makes that routine). That is
# http://192.168.x.x, not localhost, and the cookie will vanish without a word. Rename
# to sw_session for that session — the Secure flag drops automatically once the prefix
# is gone and DEPLOY_ENV=local.
SESSION_COOKIE_NAME=__Host-sw_session

# 32 bytes, base64. Encrypts TOTP shared secrets at rest (AES-256-GCM).
# Generate a real one with: openssl rand -base64 32
# Rotating this invalidates every enrolled authenticator.
ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlLW1lISE=

# Comma-separated. Doubles as the CORS allowlist AND the CSRF same-origin check,
# so an origin listed here can make state-changing calls with cookies.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- object storage (MinIO locally, S3-compatible in production) --------------

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skillwright-uploads
S3_ACCESS_KEY_ID=skillwright
S3_SECRET_ACCESS_KEY=skillwright-dev-secret
# MinIO needs path-style addressing; most managed S3 endpoints do not.
S3_FORCE_PATH_STYLE=true

# --- mail (Mailpit locally — inbox at http://localhost:8025) ------------------

SMTP_HOST=localhost
SMTP_PORT=1025
# Mailpit accepts any credentials, including none.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Skillwright <no-reply@skillwright.local>"

# --- feature flags -----------------------------------------------------------

# Enables POST /api/v1/auth/demo, which mints a read-mostly DEMO session without a
# password. Refused unconditionally when DEPLOY_ENV=production, flag or no flag.
DEMO_MODE=true

# --- logs, tracing and the absence of a metrics endpoint ---------------------
#
# There is no APM vendor, no OpenTelemetry exporter and no /metrics route, and that is
# a decision rather than an omission. What the process produces is one structured JSON
# line per request on stdout, and the whole of the observability work is making a
# request followable through those lines.
#
# To follow one request end to end:
#   1. the response carries `x-request-id` on EVERY path, including a 404;
#   2. a `problem+json` body carries the same value in `requestId` — this is what a
#      user can quote back to you;
#   3. every log line carries `requestId` (bound from the ambient request scope, so it
#      reaches lines emitted deep inside a service that never saw the request object)
#      plus `actorId` once auth.plugin has resolved the session;
#   4. the `AuditEvent` row the write produced carries the same value, so a compliance
#      question and a support question are answered by the same grep.
#
# So: `grep <requestId>` on whatever already collects this process's stdout. Shipping
# it somewhere is your log shipper's job and needs nothing from this application.
#
# THERE IS NO /metrics ENDPOINT, deliberately. Everything this process could honestly
# report — request counts, error counts, rate-limit refusals — is per-process and resets
# when a worker restarts, which is a scraping contract rather than a counter. Exposing
# it would also mean a network surface whose authorization is a policy decision
# (packages/shared/src/policy/policy.ts is not this phase's file), and the numbers would
# be wrong the moment there is more than one replica. The per-request line already
# carries method, route pattern, status and durationMs, which is what a rate, a latency
# percentile and an error ratio are computed FROM.
#
# LOG_LEVEL is the only switch. It applies to pino and to the Prisma query logger
# (packages/db/src/logger.ts), and `silent` genuinely silences both — a level that
# misses that logger's table falls through to its noisiest setting, which is LESSONS-
# LEARNED #8 and the reason the mapping is explicit.

# --- compose host ports ------------------------------------------------------

# Read by docker-compose.yml only. Every one has a working default, so a fresh
# clone needs none of them. Set one when another process on your machine already
# owns that port — `docker compose up` fails with "port is already allocated",
# and other projects' containers with `restart: unless-stopped` come back every
# time Docker Desktop starts. If you change one, change the URL above to match:
# REDIS_PORT pairs with REDIS_URL, MINIO_PORT with S3_ENDPOINT, POSTGRES_PORT
# with DATABASE_URL, MAILPIT_SMTP_PORT with SMTP_PORT.
#POSTGRES_PORT=5433
#REDIS_PORT=6379
#MINIO_PORT=9000
#MINIO_CONSOLE_PORT=9001
#MAILPIT_SMTP_PORT=1025
#MAILPIT_UI_PORT=8025

# --- rate limiting -----------------------------------------------------------
#
# Five buckets, not one. They were one, and the one was shared with the SPA's
# fingerprinted assets — so a single cold-cache page load spent the budget the API was
# answering from — and it was keyed on `request.ip`, which behind any load balancer is
# the LOAD BALANCER. Thirty staff in one office share one counter.
#
# Every response the limiter counted carries `x-ratelimit-limit` and
# `x-ratelimit-remaining`, which is how you tell which bucket a request was judged
# against without reading the source.

# Anonymous API calls, per address. RATE_LIMIT_GLOBAL_MAX is the FLOOD ceiling: the
# number is only meaningful when TRUST_PROXY_HOPS is set to your real hop count, and
# 0 means every anonymous caller in the world shares one counter.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# Signed-in API calls, per USER ID. Needs no proxy configuration at all, which is the
# point: a school behind one NAT gets one counter per person, not one counter per
# office. Generous because a busy page is a handful of calls, not hundreds.
RATE_LIMIT_API_USER_MAX=600
RATE_LIMIT_API_USER_WINDOW_MS=60000

# The SPA shell and everything under /assets. Ten times the API ceiling, and for a
# reason: a browser decides on its own how many chunks to pull, and those are the
# cheapest requests this process serves. They should never be the thing that refuses a
# user's data.
RATE_LIMIT_ASSET_MAX=3000
RATE_LIMIT_ASSET_WINDOW_MS=60000

# Strict per-IP bucket on credential endpoints: stops one host trying many accounts.
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_AUTH_IP_WINDOW_MS=60000

# Strict per-account bucket on the same endpoints: stops many hosts trying one
# account. Both buckets are needed — either one alone is bypassed by rotating the
# other dimension.
RATE_LIMIT_AUTH_ACCOUNT_MAX=10
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=900000

# --- upload quota ------------------------------------------------------------
#
# A PRODUCT DECISION, and the numbers are arguable — 50 GiB in particular is a
# placeholder for a real storage budget, and it is wrong in a DIRECTION, because the
# alternative is no ceiling at all. The reasoning is in
# apps/api/src/modules/uploads/uploads.service.ts; the short version:
#
#  - bytes per account stops ONE person filling a bucket. The largest single permitted
#    upload is 512 MB, so 2 GiB still allows four of them, and a full course library of
#    documents is tens of megabytes — a legitimate user does not reach 2 GiB by accident.
#  - rows per account stops a flood that costs almost nothing in bytes. 500 avatar
#    uploads of 2 KB is 4 MB and 500 rows for the sweeper to walk.
#  - total bytes makes "the disk is full" a 413 that names the cause, rather than a
#    write error from the object store that nobody can act on.
#
# 0 disables a ceiling for that dimension, and is the ONLY way to turn one off. The
# refusal is a 413 PAYLOAD_TOO_LARGE raised at presign — before the signature exists,
# because by commit time the bytes are already in the bucket and a limit that arrives
# late is a monitoring signal rather than a limit.
UPLOAD_USER_MAX_BYTES=2147483648
UPLOAD_USER_MAX_FILES=500
UPLOAD_BUCKET_MAX_BYTES=53687091200

# --- abandoned-upload sweeper --------------------------------------------------

# A presign writes the Upload row before any bytes exist; a dialog closed early leaves
# it behind. The sweeper runs in-process on this interval and deletes UPLOAD rows still
# PENDING past the max age (object first, then row). COMMITTED rows are never touched —
# the upload client reuses them across retries.
UPLOAD_SWEEP_INTERVAL_MS=300000
UPLOAD_SWEEP_MAX_AGE_MS=86400000

# --- retention sweeper -------------------------------------------------------
#
# One timer that reclaims rows the database already knows are dead, plus the audit
# trail's own retention. Every pass selects only on EXPIRY — a lapsed session clock, a
# passed verification TTL, a SPENT recovery code, a passed account-deletion cool-off —
# and never on age alone, because an unused recovery code is a live password-equivalent
# credential and a twenty-year-old account nobody asked to delete is still an account.
RETENTION_SWEEP_INTERVAL_MS=3600000

# How many due account deletions ONE tick may finalise. A per-run work bound, not an
# interval, and not a policy: every account whose cool-off has passed is finalised on
# some tick whatever this says, and a backlog larger than one run simply drains over
# successive ticks. See apps/api/src/modules/users/users.lifecycle.service.ts.
ACCOUNT_DELETION_SWEEP_MAX_PER_RUN=100

# How long a SPENT recovery code's hash is kept before it is reclaimed. This age never
# applies to an unused code at any age. See packages/db/src/retention/sweepers.ts.
SPENT_RECOVERY_CODE_SWEEP_MAX_AGE_MS=2592000000

# --- audit retention: UNSET ON PURPOSE ---------------------------------------
#
# There is deliberately no value here. How long a school must keep an audit record is a
# policy question this repository has not answered, and a default would answer it
# silently, in a file nobody reads, on a schedule nobody chose — deleting compliance
# evidence to look tidy.
#
# Unset (or 0) means KEEP EVERYTHING: the pruner runs, deletes nothing, and the API logs
# that state on every boot. Set a number in DAYS only if you have a real obligation to
# act on; the trade-off is that until you do, the audit table grows without bound.
# See SECURITY.md, "What is deliberately not decided yet".
#
# AUDIT_RETENTION_DAYS=365

# --- optional overrides (every one has a working default) ---------------------
#
# Listed because .env.example claims to be the source of truth for every port and
# key, and these were read by code while appearing nowhere here.
#
# The keys BELOW the rate-limit and upload-quota sections above are the exception to
# the other exception: they are validated where they are read, not in apps/api/src/env.ts.
# RATE_LIMIT_API_USER_*, RATE_LIMIT_ASSET_*, UPLOAD_USER_MAX_BYTES,
# UPLOAD_USER_MAX_FILES and UPLOAD_BUCKET_MAX_BYTES are parsed by the module that owns
# them — apps/api/src/plugins/ratelimit.plugin.ts and
# apps/api/src/modules/uploads/uploads.service.ts — with the same rule env.ts uses: a
# bad value stops the process at module load and names the key. They are not in env.ts
# because env.ts is not this phase's file, and a second copy of the schema is worse than
# one at the point of use. If they are ever promoted into env.ts, delete them from here
# and from the owning module together.
#
# AUDIT_CONNECTION_LIMIT   packages/db/src/client.ts — pool size for the audit
#                          extension's SECOND connection pool (default 10). ADR 0006:
#                          it must not share the transactional pool or approvals
#                          deadlock at concurrency.
# TEST_DATABASE_URL        apps/api/test/setup.ts — a whole database for one test
#                          worker, so two parallel runs cannot truncate each other's
#                          rows. Must end in _test. See `pnpm db:test:setup`.
# TEST_LOG_LEVEL           apps/api/test/setup.ts — defaults to silent; set to debug
#                          when a test failure needs the server's own account.
# SCREENSHOTS_BASE_URL     scripts/screenshots.ts — point the capture run at a
#                          different web origin than http://localhost:5173.
# WEB_DIST_DIR             apps/api/src/env.ts — absent in dev (Vite serves the SPA);
#                          the Docker image sets it, which is what makes the API
#                          serve the built SPA single-origin.
