# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*

# build output
dist/
build/
out/
.turbo/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example

# test & coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# runtime & uploads
# ANCHORED. A bare `uploads/` matches a directory of that name at ANY depth, which
# silently swallowed apps/api/src/modules/uploads/ — the module was on disk, compiled,
# and invisible to git. Only the runtime directory at the repository root is meant.
/uploads/
tmp/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# working docs are local-only; ADRs, the generated permission matrix and the two
# running logs ship — a progress log that vanishes on a fresh clone is useless
docs/*
!docs/adr/
!docs/permissions.md
!docs/PROGRESS.md
!docs/LESSONS-LEARNED.md
# The deferral register: what is deliberately NOT done, and what would unblock it.
# Same reasoning as the two logs above — a decision to leave something alone that
# lives only in a commit message is a decision the next person undoes by accident.
!docs/DEFERRED.md
# The README's hero image and gallery live here. `docs/*` above would have swallowed
# them, and a screenshot that is not committed is a broken image on the one page a
# stranger actually reads — the same shape of miss as the anchored `/uploads/` rule.
!docs/screenshots/
# The feature roadmap. `docs/*` above would swallow it, and a plan nobody can read from
# the repository is a plan that only exists on one machine.
!docs/roadmap/
# The UI-enhancement roadmap — same reasoning as docs/roadmap/ above.
!docs/ui-roadmap/
# The rebuild plan and the design direction. These two are CITED — 14 times and once,
# from NEXT.md, docs/roadmap/ and docs/ui-roadmap/ — as the backlog and the scope
# authority, and every one of those was a dangling reference on a fresh clone, pointing
# at a file only this machine had. The other four under docs/rebuild/ are working notes
# nothing links to (the audit findings alone are 384 KB); they stay local, which is what
# the docs/* rule above is for.
!docs/rebuild/
docs/rebuild/*
!docs/rebuild/00-REBUILD-PLAN.md
!docs/rebuild/02-design-direction.md

# editor & os
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
