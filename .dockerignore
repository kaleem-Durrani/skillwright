# Everything the build stage would only have to delete again.
# Note: pnpm-lock.yaml and pnpm-workspace.yaml MUST stay out of this file —
# the deps stage copies them before anything else.

# Dependencies — reinstalled from the lockfile inside the image
node_modules
**/node_modules

# Build output and caches — rebuilt inside the image
dist
build
out
.turbo
**/dist
**/build
**/.turbo
*.tsbuildinfo

# Version control and CI
.git
.gitignore
.github
.husky

# Secrets and local state
.env
.env.*
!.env.example
uploads
tmp

# Tests, coverage and reports — the image ships neither
coverage
.nyc_output
playwright-report
test-results
blob-report
**/*.test.ts
**/*.spec.ts
# The e2e TREE is deliberately NOT excluded here.
#
# It used to be (`**/e2e`), and that broke the image build on 2026-09-28 with
#   playwright.config.ts:7:8 - error TS2307:
#   Cannot find module './e2e/real/stack.js'
# because playwright.config.ts is typechecked by the same `tsc -b` as the app, and
# it imports that module at the top level. On a working tree the file is right
# there, so `pnpm build` passed; inside the image `COPY . .` had skipped it, so the
# identical command failed. `**/*.spec.ts` below already excludes every actual test
# file, and what is left — fixtures.ts, e2e/real/stack.ts, auth.setup.ts,
# setup-db.ts — is about 25 kB of helper module that the config cannot compile
# without. None of it reaches the shipped image: the runtime stage copies only
# /prod/api and /app/apps/web/dist.

# Docs and planning
docs
*.md
!README.md
LICENSE

# Legacy trees pending deletion
backend
frontend
package-lock.json

# Editor and OS
.vscode
.idea
.DS_Store
Thumbs.db
*.log

# Container files themselves
Dockerfile
.dockerignore
docker-compose.yml
