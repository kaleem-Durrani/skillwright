// Skillwright data model.
//
// Design rules enforced throughout this file:
//   1. ONE identity table. Role is a column, never a table. Profiles are 1:1 satellites.
//   2. Explicit `onDelete` on EVERY relation. No implicit defaults, anywhere.
//   3. Soft delete via `deletedAt` on anything a human can remove; hard delete only
//      for rows that are pure infrastructure (sessions, verifications, uploads).
//   4. Every foreign key and every column used in a WHERE or ORDER BY is indexed.
//   5. Invariants that the database can hold are held by the database — see the
//      CHECK constraints added in migration 0002, not by application code alone.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
  binaryTargets   = ["native"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  /// Registered, email not yet confirmed. Can log in but `can()` denies everything
  /// except resending verification.
  PENDING_VERIFICATION
  ACTIVE
  /// Set by an admin. Every session is destroyed on transition; login is refused.
  SUSPENDED
}

/// Why a session exists. DEMO sessions are issued by the demo endpoint and are
/// denied any mutating action by the policy layer.
enum SessionProvenance {
  PASSWORD
  DEMO
  /// Password accepted, TOTP still outstanding. This session may ONLY call
  /// /auth/mfa/verify — every other action is denied by policy.
  MFA_PENDING
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
}

/// Presence is a record of fact, not a judgement of work — which is why the set
/// stops at three and reserves nothing for assessment (see ResourceType).
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

/// Set explicitly by the creator. Never inferred from a MIME type — inferring is
/// what made this enum meaningless in the previous system.
/// QUIZ is still deliberately absent: there is no question bank, no attempt timer and
/// no autograding, and a reserved enum value is an invitation to build one.
/// ASSIGNMENT is no longer absent. It was, until migration 0010, with the reasoning
/// above — and that reasoning was correct while there was no assessment engine, which
/// is exactly what it said: "a reserved enum value is an invitation to build it". The
/// engine now exists, and an assignment's brief is course material a school already
/// files through this table — the welding procedure, the drawing, the candidate
/// guidance — so the reversal avoids a SECOND attachment mechanism for bytes this one
/// already stores, each with its own presign/commit path and its own visibility
/// answer. `Assignment.resourceId` points at a real Resource row, not at an Upload.
enum ResourceType {
  DOCUMENT
  VIDEO
  LINK
  ASSIGNMENT
}

/// Where a hand-in is in the grader's hands. NOT the same axis as a mark: GRADED
/// carries a score, RETURNED carries only feedback and asks for another attempt, and
/// SUBMITTED is what arrives unopened. The three were separate values rather than a
/// score being optional because "returned with a zero" and "returned for another go"
/// are different things to say to a student.
enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum AnnouncementType {
  NEWS
  EVENT
  ANNOUNCEMENT
}

enum UploadStatus {
  /// Presigned URL issued, bytes not yet confirmed in the bucket.
  PENDING
  /// HeadObject confirmed real content-type and size; row is referenced by a domain entity.
  COMMITTED
}

enum DurationUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

enum NotificationType {
  ENROLLMENT_REQUESTED
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  ENROLLMENT_WITHDRAWN
  ENROLLMENT_COMPLETED
  COURSE_PUBLISHED
  RESOURCE_PUBLISHED
  ANNOUNCEMENT_PUBLISHED
  MESSAGE_RECEIVED
  COMMENT_REPLIED
  COMMENT_POSTED
  ACCOUNT_SUSPENDED
  /// Phase 3. Awarding the outcome the school exists to produce is the one event in
  /// this chain a student has no other way of learning about: the PDF exists, the
  /// Qualifications tab exists, and neither of them notifies anybody. The enum member
  /// needed a migration nobody had asked for — this is that migration (0013).
  CERTIFICATE_ISSUED
  /// A SEPARATE member rather than a second row under the one above, because the
  /// notifications page filters by type and a withdrawal filed as "issued" answers the
  /// question "what has been awarded to me" with the opposite sentence.
  CERTIFICATE_REVOKED
  /// The assessment half of the chain, and the debt commit 95b0913 wrote down when it
  /// shipped grading: "a graded hand-in sends no notification, which needs a
  /// NotificationType member and therefore a migration nobody asked for." Migration
  /// 0013's own header claims to have paid this sentence, but the members it added are
  /// certificates; the two here are the actual payment, in migration 0014.
  SUBMISSION_GRADED
  /// Separate from the member above, on the same argument as CERTIFICATE_REVOKED: a hand-in
  /// sent back for another attempt filed under "graded" would show a student a mark they
  /// were not given. `returnWork` keeps the two as separate verbs for the same reason.
  SUBMISSION_RETURNED
  /// Someone else took a seat out of a thread the recipient was in. `leftAt` is the
  /// only record of who was in a conversation and who is no longer, so a removal that
  /// passed unannounced would leave the recipient with a badge nothing can clear and a
  /// roster entry they cannot explain. A SELF leave needs no member: the person who
  /// pressed the button already knows, and a notification to yourself is noise.
  CONVERSATION_REMOVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  SUSPEND
  REINSTATE
  APPROVE
  REJECT
  COMPLETE
  PUBLISH
  MFA_ENABLE
  MFA_DISABLE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id       String     @id @default(cuid())
  /// citext: case-insensitive uniqueness at the database level, so "A@b.com"
  /// and "a@b.com" cannot both exist. The previous system enforced this nowhere.
  email    String     @unique @db.Citext
  /// Argon2id. Null only for accounts provisioned by an admin who have not yet
  /// set a password via the invite flow.
  passwordHash String?
  role     Role
  status   UserStatus @default(PENDING_VERIFICATION)

  name        String
  phoneNumber String?
  bio         String?

  avatarUpload   Upload? @relation("UserAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)
  avatarUploadId String? @unique

  // --- optional TOTP two-factor ---
  /// AES-256-GCM ciphertext of the TOTP shared secret. Never leaves the server.
  /// Non-null does NOT mean enabled — enrolment is only complete once the user
  /// has proved one code and `totpEnabledAt` is set.
  totpSecret     String?
  totpEnabledAt  DateTime?
  /// Highest TOTP counter already accepted, so a code cannot be replayed inside
  /// its own validity window.
  totpLastUsedCounter BigInt?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // --- account deletion, Phase 6 ---
  //
  // `deletedAt` alone is an instant, unappealable account deletion served over
  // HTTP, which this schema refuses to model: rule 3 says anything a human can
  // remove is SOFT deleted precisely so the removal is reversible while the record
  // still has a reader. So a request writes these two and nothing changes until
  // the second passes — the cool-off, during which the requester can still sign in
  // and cancel. See migration 0011_user_lifecycle for why two nullable timestamps
  // rather than a status enum, and why nothing else on the row is destroyed.
  /// When the person asked. Null for every account that never has.
  deletionRequestedAt DateTime?
  /// When the soft delete takes effect. Never earlier than deletionRequestedAt.
  deletionEffectiveFor DateTime?

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  sessions      Session[]
  recoveryCodes RecoveryCode[]
  verifications Verification[]

  coursesTaught     Course[]                  @relation("CourseTeacher")
  enrollments       Enrollment[]              @relation("EnrollmentStudent")
  enrollmentsDecided Enrollment[]             @relation("EnrollmentDecidedBy")
  enrollmentsCompleted Enrollment[]           @relation("EnrollmentCompletedBy")
  attendanceMarked  AttendanceRecord[]        @relation("AttendanceMarkedBy")
  submissionsGraded Submission[]              @relation("SubmissionGradedBy")
  /// Phase 3. Three directions, three named relations: a student HOLDS these, a
  /// colleague ISSUED them, and a colleague REVOKED one. Named rather than merged
  /// because `User` already carries a relation of each of those three shapes for
  /// another entity (`Resource.authorId` and `Announcement.authorId` are both
  /// `isAuthor`), and a merged pair would make every one of them ambiguous to Prisma
  /// and unreadable to the next person.
  qualificationsHeld    StudentQualification[] @relation("StudentQualificationStudent")
  qualificationsIssued  StudentQualification[] @relation("StudentQualificationIssuedBy")
  qualificationsRevoked StudentQualification[] @relation("StudentQualificationRevokedBy")
  resourcesAuthored Resource[]                @relation("ResourceAuthor")
  announcements     Announcement[]            @relation("AnnouncementAuthor")
  comments          Comment[]                 @relation("CommentAuthor")
  uploads           Upload[]                  @relation("UploadOwner")
  conversations     ConversationParticipant[]
  messages          Message[]                 @relation("MessageSender")
  notifications     Notification[]
  auditEvents       AuditEvent[]              @relation("AuditActor")

  @@index([role, status])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  // Serves the due-deletion sweep, which filters on this column AND on
  // `deletedAt IS NULL`. Migration 0011_user_lifecycle; see that file for why the
  // sweep is indexed rather than left to a sequential scan on every request.
  @@index([deletionEffectiveFor])
}

model TeacherProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentId String

  qualification  String
  specialization String?
  /// Employee/staff reference. Optional because admins provision teachers before
  /// HR assigns one.
  staffNo        String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model StudentProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentId String

  enrollmentNo String   @unique
  enrolledOn   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Sessions & credentials
// ---------------------------------------------------------------------------

/// Server-side opaque sessions. The cookie carries 32 random bytes; only the
/// SHA-256 of that value is stored, so a database leak does not yield live
/// sessions. Revocation is a DELETE, which is the whole point of not using JWTs.
model Session {
  id        String            @id @default(cuid())
  tokenHash String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  provenance SessionProvenance @default(PASSWORD)

  /// Sliding window. Refreshed on use, capped by absoluteExpiresAt.
  expiresAt         DateTime
  /// Hard ceiling. Never extended.
  absoluteExpiresAt DateTime

  ip        String?
  userAgent String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use TOTP recovery codes. Argon2id hashed, exactly like passwords —
/// they are password-equivalent credentials.
model RecoveryCode {
  id       String    @id @default(cuid())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

/// Email verification and password reset. A `purpose` discriminator means a
/// verification code can never be spent as a reset code — the previous system
/// used one column pair for both.
model Verification {
  id      String              @id @default(cuid())
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  purpose VerificationPurpose

  /// SHA-256 of the 6-digit code. Never stored in plaintext.
  codeHash String
  /// For EMAIL_CHANGE, the address being moved to.
  payload  String?

  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  courses         Course[]
  teacherProfiles TeacherProfile[]
  studentProfiles StudentProfile[]

  @@index([deletedAt])
}

model Course {
  id          String  @id @default(cuid())
  code        String  @unique
  slug        String  @unique
  name        String
  description String?

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentId String

  teacher   User   @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  teacherId String

  /// Structured duration. Never a free-text string like "6 months".
  durationValue Int
  durationUnit  DurationUnit

  syllabusUpload   Upload? @relation("CourseSyllabus", fields: [syllabusUploadId], references: [id], onDelete: SetNull)
  syllabusUploadId String? @unique

  /// The course a student must hold an APPROVED seat in before they may request
  /// this one. Self-relation; chains fall out of pointing each rung at the one
  /// below it (101 -> 201 -> 301). Enforced by `hasCompletedPrerequisite` on
  /// `enrollment:request`, not by anything in the database.
  ///
  /// onDelete: SetNull, not Restrict or Cascade — losing the prerequisite must
  /// not delete courses. Cascade would destroy real courses because their ladder
  /// rung was retired; Restrict would make the rung undeletable forever. Clearing
  /// the pointer degrades honestly to "no prerequisite".
  prerequisite   Course? @relation("CoursePrerequisite", fields: [prerequisiteCourseId], references: [id], onDelete: SetNull)
  prerequisiteCourseId String?

  /// Courses this one gates. Back-relation Prisma requires; nothing reads it yet.
  prerequisiteFor Course[] @relation("CoursePrerequisite")

  /// Publication is a property of the COURSE — the thing the catalogue lists and the
  /// thing resources hang off — not of one intake. Publishing or unpublishing is one
  /// verb (`course:publish`) that moves the whole course, every offering included.
  /// Whether a particular intake is open lives on the offering: its dates say so.
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  offerings CourseOffering[]
  resources Resource[]

  @@index([departmentId])
  @@index([teacherId])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([departmentId, publishedAt])
  @@index([prerequisiteCourseId])
}

/// One scheduled run of a Course — an intake, a cohort, a term's offering.
///
/// Phase 9 split `Course` in two because trade schools run repeating intakes: the
/// seed used to announce "Spring intake applications now open" and CourseDetail.tsx
/// said "apply again for the spring cohort", but the schema carried exactly one
/// startDate/endDate/capacity, so neither sentence was backed by anything.
///
/// Everything that repeats per intake lives here; everything that identifies or
/// describes the course itself stays on Course (see that model). The split follows
/// the file's own discipline: one identity table plus satellites, explicit
/// onDelete everywhere.
///
/// The guarded numbers (ADR 0006) moved WITH the seats they guard:
///   - `capacity` / `workshopCapacity` / `approvedCount` were columns of the single
///     term a Course used to model, and seats are sold per intake;
///   - the CHECK constraints (`course_offering_capacity_sane`,
///     `course_offering_workshop_capacity_sane`, migration 0007) and the atomic
///     conditional UPDATE in enrollments.service.ts follow them;
///   - `@@unique([studentId, offeringId])` on Enrollment makes "apply again for the
///     spring cohort" a NEW row on a new offering instead of a reused one, which is
///     what finally separates a student's intake histories (migration 0004's caveat).
model CourseOffering {
  id String @id @default(cuid())

  /// The course this run is of. Cascade mirrors every other owned child
  /// (Enrollment→course, Resource→course): a hard-deleted course takes its runs,
  /// and soft delete is the only path application code uses anyway.
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  capacity Int
  /// Workshop seats. Null means unbound — a lecture offering has no workshop.
  /// A second bound on the SAME approvedCount: approval seats only while BOTH
  /// hold (ADR 0006's conditional increment applied twice in one WHERE).
  /// Guarded by CHECK (workshopCapacity IS NULL OR workshopCapacity > 0),
  /// migrated from Course in 0007_cohorts.
  workshopCapacity Int?
  /// Denormalised count of APPROVED enrollments on THIS offering, maintained inside
  /// the approval transaction. Guarded by CHECK (approved_count BETWEEN 0 AND
  /// capacity) so the database refuses to oversell even if application code is wrong.
  approvedCount Int @default(0)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]
  assignments Assignment[]

  @@index([courseId])
  @@index([deletedAt])
}

model Enrollment {
  id String @id @default(cuid())

  student   User   @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  /// The intake the seat is requested for — never the course directly. One row per
  /// (student, offering), so a student who completes the autumn cohort may apply to
  /// the spring one as a NEW row while the old history stays intact. The course is
  /// always `offering.course`; nothing denormalises it.
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringId String

  status EnrollmentStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  /// Which teacher or admin approved/rejected. Kept even if they later leave.
  decidedBy   User?     @relation("EnrollmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById String?
  /// Shown to the student on rejection.
  decisionNote String?

  /// When the qualification was recorded. Null on every other row, and the ONLY
  /// thing that distinguishes a completed student from one merely approved: a seat is
  /// a position, a completion is the outcome the school exists to issue. The status
  /// enum alone says which; this says when, which is what a certificate is dated with.
  completedAt DateTime?
  /// Who recorded it. `SetNull` for the same reason as `decidedBy` above — an audit
  /// trail with an actor is what the whole extension exists to produce, and a teacher
  /// who later leaves must not take the qualification they signed for with them.
  completedBy   User?     @relation("EnrollmentCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedById String?

  updatedAt DateTime @updatedAt

  attendanceRecords AttendanceRecord[]
  submissions       Submission[]
  /// Certificates conferred through this seat, and the reason a certificate can be
  /// traced back to a register rather than floating free of one. `SetNull` from the
  /// certificate's end — see `StudentQualification.enrollmentId`.
  qualifications    StudentQualification[]

  /// One enrollment row per (student, OFFERING). A withdrawn student who re-applies
  /// to the same intake updates this row rather than creating a second one; applying
  /// to a DIFFERENT intake of the same course creates a new row — that distinction
  /// is what Phase 9's split exists to express.
  @@unique([studentId, offeringId])
  @@index([offeringId, status])
  @@index([studentId, status])
  @@index([decidedById])
  @@index([completedById])
}

/// One row per (enrollment, session date). Marking a register twice for the same
/// day CORRECTS the row rather than duplicating it — the same discipline as
/// `Enrollment @@unique([studentId, offeringId])`.
///
/// A satellite on Enrollment, not on (User, Course): presence only means anything
/// about a seat someone actually holds. Since Phase 9's split each intake has its
/// OWN enrollment rows, so a student's separate intakes of one course no longer
/// share a history thread (migration 0004's caveat is resolved, not extended).
model AttendanceRecord {
  id String @id @default(cuid())

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String

  /// The teaching day this row is about — a bare calendar date, not an instant.
  sessionDate DateTime @db.Date

  status AttendanceStatus

  /// Which teacher or admin marked it. Kept even if they later leave, exactly like
  /// Enrollment.decidedById.
  markedBy   User?  @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  markedById String?

  /// Free text: "left early for an apprenticeship", not a grade.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The unique pair IS the read path for per-enrollment history; the date index
  /// serves per-course-by-date reads that arrive through the enrollment join.
  @@unique([enrollmentId, sessionDate])
  @@index([sessionDate])
}

/// One piece of assessed work set on ONE intake. Migration 0010; see that file's
/// header for the four shapes that were argued rather than reached for.
///
/// `offeringId` and never `courseId`: a deadline belongs to a run of the course, so
/// the template re-run five times a year has five different deadlines and five
/// different sets of hand-ins. Everything per-intake since migration 0007 — seats,
/// dates, the register — points the same way, and an assignment on the template would
/// put one March deadline on the autumn cohort.
model Assignment {
  id String @id @default(cuid())

  title String
  /// The task itself, in the words the teacher gave. Required rather than optional:
  /// a hand-in with no brief is a file the student cannot act on, and the dialogue
  /// asking what it was for happens after the deadline.
  brief String
  dueAt DateTime
  /// Out of what, as a decimal because half marks are real and an integer column
  /// makes a teacher round 62.5 in their head before writing it down. CHECK
  /// (maxScore > 0) in migration 0010 — a task worth zero points is a data-entry
  /// accident, and Phase 3's certificate will divide a total by this.
  maxScore Decimal @db.Decimal(10, 2)

  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringId String

  /// The brief as an uploaded artefact — a real Resource row, not an Upload, so it
  /// already has an author, a public flag and a course-scoped visibility answer and
  /// this model does not have to restate any of them (ResourceType gained
  /// ASSIGNMENT in migration 0010 for exactly this).
  ///
  /// SetNull: a brief is ATTACHED material. Deleting the resource must not delete the
  /// assignment — an assessment whose text has been superseded still has a deadline
  /// and still has hand-ins against it.
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  resourceId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  submissions Submission[]

  /// The read path a teacher's own list takes: one intake's tasks in deadline order.
  /// `dueAt` alone is the student's cross-course list, and the compound index serves
  /// it because the offering filter is always present there too.
  @@index([offeringId, dueAt])
  @@index([resourceId])
  @@index([deletedAt])
}

/// One hand-in, by one seated student, for one assignment, at one attempt.
///
/// `enrollmentId` and NOT `studentId`. A seat is required before a hand-in, and
/// `Enrollment` is already "this student holds this seat in this intake" — the row the
/// register already rides (migration 0004) and the one `enrolledApproved` can gate on.
/// A `studentId` here would be a second, parallel way to say who a student is, and the
/// two could disagree.
///
/// The unique triple means a RESUBMISSION IS A NEW ROW and the history survives:
/// overwriting the first hand-in would destroy the only record of what a student
/// turned in before their teacher read it, and a grader who reconsiders would
/// silently rewrite the evidence. Same shape as `AttendanceRecord`'s unique pair,
/// where marking twice corrects; here hand-in twice is two facts rather than one
/// corrected one.
model Submission {
  id String @id @default(cuid())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String

  /// The bytes of the hand-in. `onDelete: Restrict`, the action migration 0003 gave
  /// `Resource.uploadId` for the same reason: the file IS the submission, and deleting
  /// it under a live row would destroy assessment evidence. `@unique` so one upload
  /// backs exactly one hand-in.
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  uploadId String @unique

  status SubmissionStatus @default(SUBMITTED)
  /// 1 for the first hand-in. Never renumbered and never reused: `attempt` is what
  /// the unique triple keys on, and renumbering a returned attempt would collide with
  /// the row it is meant to supersede.
  attempt     Int       @default(1)
  submittedAt DateTime  @default(now())
  score       Decimal?  @db.Decimal(10, 2)
  feedback    String?
  gradedBy    User?     @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedById  String?
  gradedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([assignmentId, enrollmentId, attempt])
  @@index([assignmentId, status])
  @@index([enrollmentId])
  @@index([gradedById])
  @@index([deletedAt])
}

/// What the school AWARDS, as distinct from what a member of staff studied.
///
/// Migration 0013; that file's header is where the argument lives. The short version:
/// `packages/db/prisma/seed.ts` has listed six real standards since before this schema
/// existed, and the only column any of them ever reached was
/// `TeacherProfile.qualification` — one free-text `String` on a STAFF profile, holding a
/// teacher's own paper qualification. The school HOSTS standards it does not model.
///
/// Soft-deleted rather than removed, because a retired standard still stands on every
/// certificate naming it. "We no longer offer Level 3" is a statement about the
/// catalogue, and the people holding one are not part of it.
model Qualification {
  id String @id @default(cuid())

  /// The standard's own identifier — "CSWIP 3.1", "C&G-L3-DIP". This is the half an
  /// employer looks the certificate up BY, which is why it is unique and why it is a
  /// separate column from `name`: "CSWIP 3.1" is a number to be verified and "Welding
  /// Inspector" is a phrase to be read, and one column cannot be both.
  code String @unique
  name String
  /// "Level 3", "Level 4", "Category I". A string rather than an integer, because the
  /// schemes in the seed's own list are not one scale — NVQ counts to 8, City & Guilds
  /// to 5, F-Gas counts to three categories — and a numeric level would be a lie about
  /// four of the six.
  level String
  /// "City & Guilds", "Pearson", "BSI". The body that actually conferred it, which is
  /// the second thing a fraudulent certificate is checked against.
  awardingBody String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  awards StudentQualification[]

  @@index([deletedAt])
}

/// One qualification, held by one student, on one date, under one reference.
///
/// `reference` is the design. It is the only `@unique` non-key column in this table and
/// its entire value is that there is exactly one of it: two rows answering to the same
/// reference would leave `GET /certificates/verify/:reference` unable to say WHICH
/// qualification it is verifying. It is 26 Crockford base32 characters over 16 CSPRNG
/// bytes, minted server-side, with the entropy floor held by a CHECK in migration 0013
/// — that route is unauthenticated, and its whole security argument is that the space
/// cannot be searched.
///
/// There is deliberately NO `@@unique([studentId, qualificationId])`, which every other
/// "this person and this thing" pair in this schema carries. A re-sit after a
/// revocation is a real event and it must leave both rows standing: overwriting the
/// first would make a revocation unrepresentable, and the public verify route would
/// then have nothing honest to say. Same discipline as `Submission`'s attempt triple.
model StudentQualification {
  id String @id @default(cuid())

  /// Cascade, while `qualificationId` below is Restrict — see migration 0013, which
  /// argues the asymmetry. In short: Phase 6 made account deletion SOFT, so this row
  /// survives a person leaving, and the cascade exists so the test fixture's
  /// `user.deleteMany` unwinds rather than failing on a Restrict.
  student   User   @relation("StudentQualificationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  /// Restrict: a catalogue entry somebody holds may not be hard-deleted, or a real
  /// qualification is orphaned. Soft delete is the only path application code takes.
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  qualificationId String

  /// When it was conferred. NOT `Enrollment.completedAt`: a completion says the
  /// course finished, and a certificate is issued on a registrar's own date, which may
  /// be months later and is what the PDF and the verify route are dated with.
  issuedAt DateTime @default(now())

  /// Who signed it. `SetNull` for the reason `Enrollment.completedById` is: the record
  /// of WHO awarded a qualification must outlive their account, and a teacher who
  /// leaves does not take the certificates they signed with them.
  issuedBy   User?   @relation("StudentQualificationIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedById String?

  /// The seat this came from — the link that makes `seat -> … -> qualify` an audit
  /// trail rather than a coincidence, and the only thing distinguishing a certificate
  /// from the same student's second attempt at the same course. The issue route refuses
  /// an enrolment that is not COMPLETED, so this row said COMPLETED when it was
  /// written.
  ///
  /// `SetNull`, not Cascade: retiring an intake must not take a student's
  /// qualification with it, which is the same reasoning that gives `completedAt` the
  /// right to outlive the course that produced it.
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  enrollmentId String?

  /// 26 Crockford base32 characters over 16 CSPRNG bytes. Crockford rather than hex
  /// because a person types this off a printout: the alphabet omits I, L, O and U, so
  /// "1IL0" cannot be mistyped into a valid-looking neighbour.
  reference String @unique

  /// The three revocation columns are written as one statement and are never
  /// half-present. `revokedById` is `SetNull` like every other attribution here, so
  /// they CAN drift: a hard-deleted revoker leaves `revokedAt` set with `revokedById`
  /// null. That is why no CHECK constrains them together — the obvious one would fire
  /// on exactly the account deletion it is meant to survive.
  revokedAt     DateTime?
  revokedBy     User?   @relation("StudentQualificationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedById   String?
  /// Required by the API whenever `revokedAt` is written, and deliberately NOT part of
  /// the public verify response. A revocation is a public fact; its grounds are not.
  revokedReason String?

  /// The PDF. `@unique` so one upload backs exactly one certificate, and `Restrict`
  /// rather than `SetNull` for the reason `Submission.uploadId` is: the bytes ARE the
  /// claim, and clearing the pointer would degrade quietly to "a certificate with no
  /// certificate" — a worse state than a refused DELETE.
  artifactUpload   Upload? @relation("StudentQualificationArtifact", fields: [artifactUploadId], references: [id], onDelete: Restrict)
  artifactUploadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the holder's own list, newest first, which is every read of a student's
  /// record.
  @@index([studentId, issuedAt])
  @@index([qualificationId])
  @@index([enrollmentId])
  @@index([issuedById])
  @@index([revokedById])
  /// No query reads this today. A revocation is the one column here whose rows get
  /// rarer over time, which is exactly the shape that makes "every certificate revoked
  /// in a window" cheap to add later and expensive not to.
  @@index([revokedAt])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

/// First-class upload record. Stores the REAL object-store key, never a URL that
/// a key must later be parsed back out of — parsing the key out of a URL is what
/// made every delete in the previous system silently fail.
model Upload {
  id     String @id @default(cuid())
  /// Server-generated: `${assetFolder}/${entity}/${ulid}${ext}`. Never the
  /// client's filename.
  key    String @unique
  bucket String

  /// What the STORE recorded, read back with HeadObject after the browser's PUT.
  /// Not a claim about the bytes: nothing sniffs them. The client declares a type at
  /// presign, that type is part of the PUT signature so the store refuses any other,
  /// and commit reads back what the store kept. A caller who declares application/pdf
  /// and uploads an executable gets a row saying application/pdf — which is why every
  /// download is served as an attachment rather than rendered inline.
  contentType String
  sizeBytes   Int
  /// What the user called it. Display only; never used to build the key.
  originalName String

  status UploadStatus @default(PENDING)

  owner   User   @relation("UploadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  createdAt   DateTime  @default(now())
  committedAt DateTime?

  resource       Resource?
  courseSyllabus Course?   @relation("CourseSyllabus")
  userAvatar     User?     @relation("UserAvatar")
  /// The bytes of a hand-in. The only attachment point that is a 1:1 REQUIRED relation
  /// rather than a nullable one, because a submission without a file is not a
  /// submission — see `Submission.uploadId`'s own comment for the Restrict.
  submission     Submission?
  /// The PDF of a certificate, generated server-side at issue time rather than
  /// uploaded by a browser. Nullable and `@unique` on the other side, and `Restrict`
  /// from the certificate's end: the same reasoning as `submission` above, arrived at
  /// by the other road. The UNIQUE claim is the interesting one — it is what lets the
  /// uploads module's `assertUploadClaimable` refuse a second claim, so a certificate
  /// upload cannot be re-pointed at somebody else's row.
  studentQualification StudentQualification? @relation("StudentQualificationArtifact")

  @@index([ownerId])
  @@index([status, createdAt])
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        ResourceType

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  author   User   @relation("ResourceAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  authorId String

  /// Exactly one of uploadId / externalUrl is set — enforced by CHECK in migration 0002.
  ///
  /// Restrict, not SetNull: SetNull plus that CHECK meant "clear the column, and also
  /// never let it be clear", so deleting a backing Upload always failed — just with a
  /// check-constraint error about a column the caller never named. Migration 0003 made
  /// the declaration match the behaviour.
  upload      Upload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  uploadId    String? @unique
  externalUrl String?

  /// Public resources are readable by anonymous visitors. Private ones require an
  /// APPROVED enrollment — enforced by the policy layer AND by the object store,
  /// which never serves an unsigned request.
  isPublic Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  comments Comment[]

  /// Briefs this resource backs. `Assignment.resourceId` is SetNull, so a deleted
  /// resource leaves the assignment standing with no uploaded brief rather than
  /// taking the assessment and its hand-ins with it.
  assignments Assignment[]

  @@index([courseId, createdAt])
  @@index([authorId])
  @@index([isPublic, deletedAt])
  @@index([deletedAt])
}

model Announcement {
  id      String           @id @default(cuid())
  title   String
  slug    String           @unique
  content String
  type    AnnouncementType

  /// Required. The previous system's NewsEvent had no author relation at all.
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  authorId String

  /// The date the event happens (for EVENT), distinct from when the post went live.
  eventDate   DateTime?
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  comments Comment[]

  @@index([publishedAt])
  @@index([type, publishedAt])
  @@index([authorId])
  @@index([deletedAt])
}

/// ONE comment table for both resources and announcements. The previous system
/// had two near-identical tables, each with nullable teacherId AND studentId —
/// four nullable columns expressing what one authorId expresses.
///
/// Exactly one of resourceId / announcementId is non-null, enforced by
/// CHECK (num_nonnulls(resource_id, announcement_id) = 1) in migration 0002.
model Comment {
  id      String @id @default(cuid())
  content String

  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String?

  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String?

  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([resourceId, createdAt])
  @@index([announcementId, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

/// N participants, not a fixed (teacherId, studentId) pair. This is what makes
/// admin participation possible at all — the previous schema physically could not
/// seat an admin, which is why its admin chat shipped a "Feature Under
/// Development" placeholder.
model Conversation {
  id      String  @id @default(cuid())
  /// Null for direct conversations; set for named group threads.
  title   String?
  /// Monotonic high-water mark. Every message takes `nextSeq` and increments it
  /// inside the same transaction, so ordering never depends on comparing cuids
  /// or timestamps.
  nextSeq BigInt  @default(1)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// One timestamp per participant replaces per-message read rows entirely.
  lastReadAt DateTime?
  /// Highest seq this participant has seen. Unread count is a range query.
  lastReadSeq BigInt   @default(0)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
}

model Message {
  id String @id @default(cuid())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId String

  /// Gap-free per conversation. Backfill after a reconnect is a range query on
  /// this column, which is why offline recovery is exact rather than approximate.
  seq BigInt

  content String

  /// Client-generated ULID. Unique per sender, so a retry after a timeout can
  /// never double-post the same message.
  clientMsgId String

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@unique([conversationId, seq])
  @@unique([senderId, clientMsgId])
  @@index([conversationId, seq])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Notification {
  id     String           @id @default(cuid())
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  type   NotificationType

  /// Denormalised render payload, so rendering a notification never needs a join
  /// to a row that may since have been deleted.
  payload Json

  /// Where clicking it goes.
  linkPath String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

/// Append-only. Written by a Prisma client extension in the data-access layer, so
/// no service can forget to write one. Migration 0002 revokes UPDATE and DELETE
/// on this table from the application role — the append-only property is enforced
/// by Postgres, not by convention.
model AuditEvent {
  id String @id @default(cuid())

  /// Null for system-initiated events (cron, queue workers).
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  action     AuditAction
  entityType String
  entityId   String

  /// Redacted diffs. Never contains password hashes, TOTP secrets, or tokens.
  before Json?
  after  Json?

  ip        String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
