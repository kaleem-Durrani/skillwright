{
  "name": "@skillwright/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, audit extension and deterministic seed for Skillwright.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "prisma"
  ],
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "argon2": "^0.41.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^22.10.5",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
