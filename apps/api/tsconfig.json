{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"],

    // The API is an application, not a library: nothing imports its types.
    "declaration": false,
    "declarationMap": false,

    // `@skillwright/shared` and `@skillwright/db` publish TypeScript SOURCE through
    // their exports maps — there is no compiled artifact for tsc's own emit to import,
    // since tsc never rewrites another package's exports map to point at a .js file it
    // just wrote. So this project's `tsc` invocation stays a pure typecheck (this flag),
    // and scripts/build.mjs does the actual emit: esbuild bundles those two workspace
    // packages' source directly into dist/main.js instead of merely referencing it.
    // Restoring real per-file `tsc` emit means giving the two packages a build step
    // first, not flipping this flag.
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
