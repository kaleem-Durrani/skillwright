{
  "name": "skillwright",
  "version": "0.1.0",
  "private": true,
  "description": "A permissions-first training platform. It happens to teach welding.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm infra:up && turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "check:brand": "tsx scripts/check-brand.ts",
    "check:mobile-first": "tsx scripts/check-mobile-first.ts",
    "db:migrate": "pnpm --filter @skillwright/db run migrate",
    "db:deploy": "pnpm --filter @skillwright/db run deploy",
    "db:seed": "pnpm --filter @skillwright/db run seed",
    "db:reset": "pnpm --filter @skillwright/db run reset",
    "db:studio": "pnpm --filter @skillwright/db run studio",
    "db:generate": "pnpm --filter @skillwright/db run generate",
    "docs:permissions": "tsx scripts/generate-permissions-doc.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "infra:up": "docker compose up -d minio-init && docker compose up -d --wait postgres redis minio mailpit",
    "infra:down": "docker compose down",
    "infra:nuke": "docker compose down -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@skillwright/shared": "workspace:*",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^5.7.3"
  }
}
